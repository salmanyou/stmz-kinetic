# ============================================================
# STMZ KINETIC — server environment
# Copy this file to ".env" and fill in YOUR OWN values.
# The app BOOTS even with nothing set — add keys as you go.
# THESE ARE SERVER SECRETS. Never paste them in chat, GitHub,
# screenshots, or anywhere outside the .env file on your server.
# If any value here ever leaks, rotate it immediately.
# ============================================================

# --- AI RELAY (you only need ONE to go live; add more for failover) ---
# Each key below accepts a SINGLE key OR multiple keys separated by commas.
# When one hits a rate limit the server tries the next one automatically.
# Example: paste 3 Groq keys from 3 free Groq accounts to triple your daily quota:
#   GROQ_API_KEY=gsk_first,gsk_second,gsk_third
# Same syntax works for OpenRouter, Gemini, and Cerebras below.
#
# Groq — free, fast. Get a key at https://console.groq.com/keys (14,400 req/day per key)
GROQ_API_KEY=
# OpenRouter — free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google Gemini — free tier. https://aistudio.google.com/apikey (1,500 req/day per key)
GEMINI_API_KEY=
# Cerebras — free tier, very fast inference. https://cloud.cerebras.ai/ (14,400 req/day per key)
CEREBRAS_API_KEY=

# Optional: override default models
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-2.0-flash
# CEREBRAS_MODEL=llama-3.3-70b

# --- FIREBASE ADMIN (required for sync + subscriptions + scheduler) ---
# Firebase console → ⚙ Project settings → Service accounts → Generate new
# private key. Paste the WHOLE JSON on one line, OR base64-encode it.
FIREBASE_SERVICE_ACCOUNT=

# --- PADDLE (payments) ---
PADDLE_WEBHOOK_SECRET=
# Paddle price IDs — one per tier. From Paddle Catalog → your products → prices.
# These are server-side so the webhook can map a paid price → the right tier.
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_AGENCY=

# --- LINKEDIN (direct posting integration) ---
# Create an app at https://www.linkedin.com/developers/apps
# Add product: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# OAuth redirect URL: https://YOUR-DOMAIN/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Random string used to sign OAuth state (anything secret works)
LINKEDIN_STATE_SECRET=change-this-to-a-long-random-string

# --- STOCK PHOTOS (Pexels, free 200/hr · 20k/month) ---
# Strongly recommended — makes the Video Studio reliable and instant.
# Without this, videos fall back to Pollinations (slow) then Picsum (random).
# Sign up free at https://www.pexels.com/api/new/ — no card required.
PEXELS_API_KEY=

# --- VOICE NARRATION (ElevenLabs, optional but recommended) ---
# The Video Studio's voice narration tries 3 providers in order:
#   1. StreamElements (free, 6 voices, no key — but their service is often 502/down)
#   2. Google Translate TTS (free, 1 voice, no key — automatic fallback)
#   3. ElevenLabs (free 10k chars/month, 6 voices, premium quality — needs key)
# If StreamElements is down (which happens often) and you want reliable voice,
# add an ElevenLabs key. Sign up free at https://elevenlabs.io
ELEVENLABS_API_KEY=

# --- SCHEDULER ---
# Used to protect /api/scheduler/tick when called by an external cron
# (cron-job.org etc.). Pick any long random string and use it as
# ?secret=<this> in the cron URL.
SCHEDULER_SECRET=change-this-to-a-long-random-string

# --- GENERAL ---
# Your live URL once deployed (used for OAuth redirect + relay referer)
# For local dev use http://localhost:3000 — in production:
APP_URL=https://stmzkinetic.com

# --- FOUNDER MODE ---
# Comma-separated Gmail addresses that get unlimited free access
# regardless of subscription status (you, your co-founders, demo accounts).
# Mirror this list in public/js/app.js → ADMIN_EMAILS for client-side UI.
ADMIN_EMAILS=your-email@gmail.com

# Per-IP request limit per minute on public proxy endpoints
# (/api/tts, /api/img-proxy, /api/stock-image, /api/stock-video).
# Default 60 — raise if legitimate users hit 429s during video generation.
PROXY_LIMIT_PER_MIN=60
DEMO_LIMIT=3
PORT=3000
